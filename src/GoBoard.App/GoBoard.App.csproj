<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>GoBoard</AssemblyName>
    <RootNamespace>GoBoard.App</RootNamespace>
    <ApplicationIcon>../../assets/branding/goboard.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/branding/goboard.ico" LogicalName="GoBoard.Icon.ico" />
    <ProjectReference Include="../GoBoard.OpenVR/GoBoard.OpenVR.csproj" />
  </ItemGroup>
</Project>
