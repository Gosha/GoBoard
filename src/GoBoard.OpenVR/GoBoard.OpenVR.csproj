<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="goboard.vrmanifest" LogicalName="GoBoard.vrmanifest" />
    <None Update="goboard.vrmanifest" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../GoBoard.Core/GoBoard.Core.csproj" />
    <ProjectReference Include="../GoBoard.Platform.Windows/GoBoard.Platform.Windows.csproj" />
    <ProjectReference Include="../GoBoard.Presentation.Skia/GoBoard.Presentation.Skia.csproj" />
    <PackageReference Include="OpenTK.Graphics" Version="4.9.4" />
    <PackageReference Include="OpenTK.Windowing.Desktop" Version="4.9.4" />
    <Compile Include="../../vendor/openvr/openvr_api.cs" Link="OpenVR/openvr_api.cs" />
    <None Include="../../vendor/openvr/openvr_api.dll" Link="openvr_api.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../vendor/openvr/LICENSE" Link="OpenVR-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="GoBoard.Tests" />
    <InternalsVisibleTo Include="GoBoard" />
  </ItemGroup>
</Project>
