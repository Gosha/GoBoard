<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">
  <!-- Development uses the Beta family and reserved MSI major 0 so even
       already-published releases can replace it without duplicate installs. -->
  <?if $(var.ReleaseChannel) != stable ?>
    <?define UpgradeCode = "56804E91-13DF-4698-908A-604D44D7320A" ?>
    <?define OtherUpgradeCode = "A8D6C499-CBD9-4DD9-9700-C5A8C9E23192" ?>
  <?else?>
    <?define UpgradeCode = "A8D6C499-CBD9-4DD9-9700-C5A8C9E23192" ?>
    <?define OtherUpgradeCode = "56804E91-13DF-4698-908A-604D44D7320A" ?>
  <?endif?>
  <Package Name="$(var.ProductName)" Manufacturer="GoBoard" Version="$(var.ProductVersion)"
           UpgradeCode="$(var.UpgradeCode)" Scope="perUser"
           Language="1033">
    <?if $(var.ReleaseChannel) = development ?>
      <Upgrade Id="$(var.UpgradeCode)">
        <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes"
                        Maximum="$(var.ProductVersion)" IncludeMaximum="yes"
                        Property="WIX_UPGRADE_DETECTED" MigrateFeatures="no" />
        <UpgradeVersion Minimum="$(var.ProductVersion)" IncludeMinimum="no"
                        Maximum="1.0.0" IncludeMaximum="no" OnlyDetect="yes"
                        Property="WIX_DOWNGRADE_DETECTED" />
        <UpgradeVersion Minimum="1.0.0" IncludeMinimum="yes"
                        Property="GOBOARD_BETA_CHANNEL_FOUND" MigrateFeatures="no" />
      </Upgrade>
      <Launch Condition="Installed OR NOT WIX_DOWNGRADE_DETECTED"
              Message="A newer Development build of GoBoard is already installed." />
      <InstallExecuteSequence>
        <RemoveExistingProducts After="InstallInitialize" />
      </InstallExecuteSequence>
    <?else?>
      <MajorUpgrade DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed."
                    Schedule="afterInstallInitialize" AllowSameVersionUpgrades="yes" />
    <?endif?>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <!-- VR has no Windows message pump for Restart Manager; older releases
         never registered for restart. Coordinate through their existing stop
         event, including repository launches outside the installation folder. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Binary Id="GoBoardLifecycle" SourceFile="$(var.LifecycleActions)" />
    <CustomAction Id="GoBoardStop" BinaryRef="GoBoardLifecycle" DllEntry="Stop" Return="check" />
    <CustomAction Id="GoBoardRestart" BinaryRef="GoBoardLifecycle" DllEntry="Restart" Return="check" />
    <CustomAction Id="GoBoardRecoverError" BinaryRef="GoBoardLifecycle" DllEntry="Recover" Return="ignore" />
    <CustomAction Id="GoBoardRecoverCancel" BinaryRef="GoBoardLifecycle" DllEntry="Recover" Return="ignore" />
    <InstallExecuteSequence>
      <!-- Execute sequence only: navigating/cancelling the wizard leaves the
           app alone. Stop before the files-in-use check, not at Finish. -->
      <Custom Action="GoBoardStop" Before="InstallValidate" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="GoBoardRestart" After="InstallFinalize" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="GoBoardRecoverError" OnExit="error" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="GoBoardRecoverCancel" OnExit="cancel" Condition="NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
    <!-- MSI's WindowsBuild can report 9600 on modern Windows. Read the real build. -->
    <Property Id="GOBOARD_WINDOWS_BUILD">
      <RegistrySearch Id="WindowsBuildSearch" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Upgrade Id="$(var.OtherUpgradeCode)">
      <UpgradeVersion Minimum="0.0.0" IncludeMinimum="yes"
                      Property="GOBOARD_OTHER_CHANNEL_FOUND" MigrateFeatures="no" />
    </Upgrade>
    <Upgrade Id="$(var.UpgradeCode)">
      <UpgradeVersion Minimum="$(var.ProductVersion)" Maximum="$(var.ProductVersion)"
                      IncludeMinimum="yes" IncludeMaximum="yes" OnlyDetect="yes"
                      Property="GOBOARD_SAME_VERSION_FOUND" />
    </Upgrade>
    <!-- Legacy packages are Offline. Equal versions may replace only the other
         payload variant; separately rebuilt same-variant packages stay blocked. -->
    <Property Id="GOBOARD_PREVIOUS_VARIANT" Value="offline">
      <RegistrySearch Id="PreviousVariant" Root="HKCU" Key="Software\GoBoard"
                      Name="SetupVariant" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR NOT GOBOARD_SAME_VERSION_FOUND OR GOBOARD_PREVIOUS_VARIANT &lt;&gt; &quot;$(var.SetupVariant)&quot;"
            Message="This setup variant of $(var.ProductName) is already installed. Use the original MSI to repair it, switch setup variants, or install a newer version." />
    <?if $(var.SetupVariant) = standard ?>
    <!-- Runs again after prerequisites and before stopping/removing an old app.
         Keep removal possible even if the shared runtime has been removed. -->
    <netfx:DotNetCompatibilityCheck Id="DesktopRuntime" Property="GOBOARD_RUNTIME_RESULT"
                                  Platform="x64" RuntimeType="desktop" Version="10.0.0" RollForward="minor" />
    <Launch Condition="REMOVE = &quot;ALL&quot; OR GOBOARD_RUNTIME_RESULT = &quot;0&quot;"
            Message="GoBoard requires a compatible x64 Microsoft .NET 10 Desktop Runtime. Run Standard setup to install it, or choose Offline setup. If .NET requested a restart, restart Windows and retry." />
    <?endif?>
    <Launch Condition="Installed OR (VersionNT64 AND GOBOARD_WINDOWS_BUILD &gt;= 19044)"
            Message="GoBoard requires Windows 10 21H2 or later (x64)." />
    <Launch Condition="NOT ALLUSERS" Message="GoBoard installs for the current user only. Run this installer without ALLUSERS." />
    <!-- MSI upgrades cannot change installation context. -->
    <Property Id="GOBOARD_MACHINE_INSTALL" Secure="yes">
      <RegistrySearch Id="MachineInstallFolder" Root="HKLM" Key="Software\GoBoard"
                      Name="InstallFolder" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR NOT GOBOARD_MACHINE_INSTALL"
            Message="An all-users GoBoard installation already exists. Uninstall it from Windows Installed apps first (this may require administrator approval), then run this per-user installer. Your settings will be kept." />

    <!-- Icon streams store the entire source file; use the ICO instead of duplicating the apphost. -->
    <Icon Id="GoBoard.exe" SourceFile="$(var.AppIcon)" />
    <Property Id="ARPPRODUCTICON" Value="GoBoard.exe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Gosha/GoBoard" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Open GoBoard VR from the Start menu. GoBoard requires SteamVR and a connected headset." />

    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKCU" Key="Software\GoBoard"
                      Name="InstallFolder" Type="raw" Bitness="always64" />
    </Property>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="GoBoard" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="GoBoardMenuFolder" Name="GoBoard" />
    </StandardDirectory>

    <Feature Id="GoBoard" Title="GoBoard" Level="1">
      <Component Directory="INSTALLFOLDER" Id="InstallationLocation" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\GoBoard" Name="InstallFolder"
                       Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RegistryValue Root="HKCU" Key="Software\GoBoard" Name="SetupVariant"
                       Type="string" Value="$(var.SetupVariant)" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveEmptyUserPrograms" Directory="UserProgramsFolder" On="uninstall" />
      </Component>
      <Component Directory="GoBoardMenuFolder" Id="GoBoardShortcuts" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\GoBoard" Name="Shortcuts"
                       Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="VrShortcut" Name="GoBoard VR" Target="[INSTALLFOLDER]GoBoard.exe"
                  WorkingDirectory="INSTALLFOLDER" Icon="GoBoard.exe" />
        <Shortcut Id="SettingsShortcut" Name="GoBoard Settings" Target="[INSTALLFOLDER]GoBoard.exe"
                  Arguments="--settings" WorkingDirectory="INSTALLFOLDER" Icon="GoBoard.exe" />
        <RemoveFolder Id="RemoveGoBoardMenu" On="uninstall" />
      </Component>
      <ComponentGroupRef Id="PublishedFiles" />
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <!-- There is no project EULA: skip WixUI's stock placeholder license page. -->
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg"
               Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg"
               Order="2" Condition="1" />
    </UI>
  </Package>
</Wix>
